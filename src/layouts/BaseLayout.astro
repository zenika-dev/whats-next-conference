---
import '../styles/global.css';
const { title, description, image, url } = Astro.props;
const siteTitle = "What's Next? — A mini-conference series by Zenika Singapore";
const siteDescription =
  "What's Next? is a recurring mini-conference on AI-Driven Development, organised by Zenika Singapore. Explore past editions, speakers and topics.";
const siteUrl = 'https://whatsnext.zenika.sg';
const pageTitle = title ? `${title} · What's Next?` : siteTitle;
const pageDescription = description ?? siteDescription;
const pageUrl = url ?? siteUrl;
const pageImage = image ?? `${siteUrl}/og-image.png`;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={pageImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={pageImage} />
    <link rel="icon" type="image/png" href="/favicon-zenika.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline async defer data-domain="whatsnext.zenika.sg" src="https://plausible.io/js/plausible.js"></script>
  </head>
  <body>
    <div class="w-full overflow-x-hidden">
      <slot />
    </div>
  </body>
</html>
