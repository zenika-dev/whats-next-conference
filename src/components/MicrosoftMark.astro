---
// The four-square Microsoft logo mark + wordmark.
// Props: size (px of each square), text (label size class), color (wordmark colour class)
interface Props {
  square?: number;
  textClass?: string;
  colorClass?: string;
}
const { square = 10, textClass = 'text-[18px]', colorClass = 'text-white' } = Astro.props;
const cell = `${square}px`;
---
<span class="inline-flex items-center gap-2">
  <span
    class="grid gap-[2px]"
    style={`grid-template-columns:repeat(2,${cell});grid-template-rows:repeat(2,${cell})`}
    aria-hidden="true"
  >
    <span style="background:#F25022"></span><span style="background:#7FBA00"></span
    ><span style="background:#00A4EF"></span><span style="background:#FFB900"></span>
  </span>
  <span class={`font-medium ${textClass} ${colorClass}`}>Microsoft</span>
</span>
