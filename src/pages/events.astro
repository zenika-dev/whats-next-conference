---
import BaseLayout from '../layouts/BaseLayout.astro';
import { events } from '../data/events';
---
<BaseLayout title="Events" description="Browse past and upcoming What\'s Next? conference editions.">
  <section class="rounded-[2rem] border border-white/10 bg-slate-950/80 p-10 shadow-soft">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-sm uppercase tracking-[0.28em] text-zenika-accent">Event archive</p>
        <h1 class="mt-3 text-4xl font-semibold text-white">All editions</h1>
      </div>
      <p class="max-w-xl text-slate-300">Review the What&apos;s Next? event history, starting with the inaugural July 2026 edition. Future editions can be added to this archive.</p>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {events.map((event) => (
        <a href={`/events/${event.slug}`} class="group rounded-[2rem] border border-slate-800 bg-slate-900/80 p-8 transition hover:border-zenika-accent/40 hover:bg-slate-800/90">
          <div class="flex flex-col gap-4">
            <div class="flex items-center justify-between gap-4">
              <div>
                <p class="text-sm uppercase tracking-[0.24em] text-slate-400">{event.date}</p>
                <h2 class="mt-2 text-2xl font-semibold text-white">{event.title}</h2>
              </div>
              <span class="rounded-full bg-zenika-accent px-3 py-2 text-xs font-semibold uppercase tracking-[0.24em] text-slate-950">{event.venue}</span>
            </div>
            <p class="text-slate-300">{event.theme}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {event.partners.map((partner) => (
                <span class="rounded-full border border-slate-700 px-3 py-2 text-xs uppercase tracking-[0.18em] text-slate-300">{partner}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
