---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { events } from '../../data/events';

export const getStaticPaths = async () => {
  return events.map((event) => ({ params: { slug: event.slug } }));
};

const { slug } = Astro.params;
const event = events.find((item) => item.slug === slug);
if (!event) {
  throw new Error('Event not found');
}
---
<BaseLayout title={event.title} description={event.description}>
  <section class="space-y-10">
    <div class="rounded-[2rem] border border-white/10 bg-slate-950/80 p-10 shadow-soft">
      <div class="grid gap-10 lg:grid-cols-[1.5fr_1fr] lg:items-start">
        <div class="space-y-6">
          <span class="inline-flex rounded-full bg-zenika-accentSoft px-4 py-2 text-sm font-semibold uppercase tracking-[0.28em] text-zenika-accent">{event.date}</span>
          <h1 class="text-4xl font-semibold leading-tight text-white">{event.title}</h1>
          <p class="text-xl leading-8 text-slate-300">{event.highlight}</p>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-3xl bg-slate-900/80 p-6">
              <p class="text-sm uppercase tracking-[0.24em] text-slate-400">Theme</p>
              <p class="mt-3 text-white">{event.theme}</p>
            </div>
            <div class="rounded-3xl bg-slate-900/80 p-6">
              <p class="text-sm uppercase tracking-[0.24em] text-slate-400">Venue</p>
              <p class="mt-3 text-white">{event.venue}</p>
            </div>
          </div>
          <div class="mt-6 flex flex-wrap gap-3">
            {event.partners.map((partner) => (
              <span class="rounded-full border border-slate-700 bg-slate-900/80 px-4 py-2 text-xs uppercase tracking-[0.18em] text-slate-300">{partner}</span>
            ))}
          </div>
        </div>
        <div class="rounded-[2rem] bg-slate-900/80 p-8">
          <h2 class="text-xl font-semibold text-white">Register interest</h2>
          <p class="mt-4 text-slate-300">Secure updates for the next edition or sign up for the conference waitlist via the external registration page.</p>
          <a href={event.registrationUrl} target="_blank" rel="noopener" class="mt-6 inline-flex w-full items-center justify-center rounded-full bg-zenika-accent px-6 py-3 text-sm font-semibold text-slate-950 transition hover:bg-red-600" onclick="window.plausible && window.plausible('Registration CTA')">Register now</a>
        </div>
      </div>
    </div>

    <div class="grid gap-10 xl:grid-cols-[1.3fr_0.7fr]">
      <article class="space-y-10 rounded-[2rem] border border-white/10 bg-slate-950/80 p-10 shadow-soft">
        <section class="space-y-6">
          <h2 class="text-2xl font-semibold text-white">Event agenda</h2>
          <div class="space-y-4">
            {event.agenda.map((item) => (
              <div class="rounded-3xl border border-slate-800 bg-slate-900/80 p-5 sm:flex sm:items-center sm:justify-between">
                <div>
                  <p class="text-sm uppercase tracking-[0.24em] text-slate-400">{item.time}</p>
                  <p class="mt-2 text-white">{item.title}</p>
                </div>
                {item.speaker ? <p class="mt-4 text-sm text-slate-300 sm:mt-0">{item.speaker}</p> : null}
              </div>
            ))}
          </div>
        </section>

        <section class="space-y-6">
          <h2 class="text-2xl font-semibold text-white">Speakers</h2>
          <div class="grid gap-6 sm:grid-cols-2">
            {event.speakers.map((speaker) => (
              <article class="rounded-3xl border border-slate-800 bg-slate-900/80 p-6">
                <div class="flex items-center gap-4">
                  <div class="h-16 w-16 rounded-3xl bg-slate-800" aria-hidden="true"></div>
                  <div>
                    <p class="text-lg font-semibold text-white">{speaker.name}</p>
                    <p class="text-sm text-slate-400">{speaker.title}, {speaker.company}</p>
                  </div>
                </div>
                <p class="mt-4 text-slate-300">{speaker.role}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="space-y-6">
          <h2 class="text-2xl font-semibold text-white">Photo gallery</h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {event.gallery.map((src, index) => (
              <img src={src} alt={`Event photo ${index + 1}`} class="h-44 w-full rounded-3xl object-cover shadow-soft" loading="lazy" />
            ))}
          </div>
        </section>
      </article>

      <aside class="space-y-8 rounded-[2rem] border border-white/10 bg-slate-950/80 p-10 shadow-soft">
        <div>
          <h2 class="text-2xl font-semibold text-white">Partners</h2>
          <p class="mt-4 text-slate-300">This edition was staged at Microsoft Singapore in collaboration with Zenika Singapore.</p>
        </div>
        <div class="space-y-4 rounded-3xl bg-slate-900/80 p-6">
          {event.partners.map((partner) => (
            <div class="rounded-3xl border border-slate-800 bg-slate-950/90 p-5 text-white">{partner}</div>
          ))}
        </div>
        <div class="rounded-3xl border border-slate-800 bg-slate-900/80 p-6">
          <h3 class="text-lg font-semibold text-white">Conference notes</h3>
          <p class="mt-3 text-slate-300 leading-7">A single-day conference focused on practical AI transformation, with panels and sessions from Singapore&rsquo;s leading AI and engineering teams.</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
