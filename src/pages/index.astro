---
import BaseLayout from '../layouts/BaseLayout.astro';
import MicrosoftMark from '../components/MicrosoftMark.astro';
import { withBase } from '../lib/site';
import { site, audience, themes, events } from '../data/events';

const edition = events[0];

// The #join-list form only exists in markup when the upcoming-edition
// teaser is shown, so a CTA can only point at it when both are true.
const joinListOpen = site.registrationOpen && site.showUpcoming;

const speakerCompanies = [...new Set(edition.speakers.map((s) => s.company))];

const navLinks = [
  { href: '#about', label: 'About' },
  { href: '#events', label: 'Events' },
  { href: '#speakers', label: 'Speakers' },
  { href: '#gallery', label: 'Gallery' },
];

const galleryTiles = [
  { span: 'sm:col-span-2 sm:row-span-2', label: 'Wide photo' },
  { span: '', label: 'Photo' },
  { span: '', label: 'Photo' },
  { span: '', label: 'Photo' },
  { span: '', label: 'Photo' },
  { span: 'sm:col-span-2', label: 'Wide photo' },
  { span: '', label: 'Photo' },
  { span: '', label: 'Photo' },
];

const galleryImages = edition.gallery.map(withBase);
---
<BaseLayout>
  <header
    class="sticky top-0 z-50 border-b border-white/10 backdrop-blur-md"
    style="background:rgba(6,15,49,0.92)"
  >
    <nav class="mx-auto flex h-[68px] max-w-shell items-center justify-between gap-5 px-6">
      <a href="#top" class="flex flex-shrink-0 items-center no-underline">
        <img src={withBase('assets/whats-next-logo-light.png')} alt="What's Next?" class="h-10 w-auto" />
      </a>
      <div class="hidden items-center gap-x-[26px] md:flex">
        {navLinks.map((link) => (
          <a href={link.href} class="text-[14.5px] font-medium text-white/80 no-underline hover:text-white hover:no-underline">{link.label}</a>
        ))}
        {joinListOpen ? (
          <a
            href="#join-list"
            class="rounded-full bg-brand px-5 py-2.5 text-[14.5px] font-semibold text-white no-underline hover:bg-brand hover:no-underline"
          >Register interest</a>
        ) : (
          <span
            aria-disabled="true"
            title="Registration is currently closed"
            class="cursor-not-allowed rounded-full bg-slate-200 px-5 py-2.5 text-[14.5px] font-semibold text-slate-400"
          >Register interest</span>
        )}
      </div>
      <button
        type="button"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle menu"
        class="flex h-9 w-9 flex-shrink-0 flex-col items-center justify-center gap-[5px] md:hidden"
      >
        <span class="h-[2px] w-5 rounded-full bg-white transition-transform"></span>
        <span class="h-[2px] w-5 rounded-full bg-white transition-opacity"></span>
        <span class="h-[2px] w-5 rounded-full bg-white transition-transform"></span>
      </button>
    </nav>
    <div id="mobile-menu" class="hidden flex-col gap-1 border-t border-white/10 px-6 py-4 md:hidden" style="background:rgba(6,15,49,0.98)">
      {navLinks.map((link) => (
        <a href={link.href} class="rounded-lg px-2 py-2.5 text-[15px] font-medium text-white/80 no-underline hover:bg-white/5 hover:text-white hover:no-underline">{link.label}</a>
      ))}
      {joinListOpen ? (
        <a
          href="#join-list"
          class="mt-2 rounded-full bg-brand px-5 py-2.5 text-center text-[14.5px] font-semibold text-white no-underline hover:no-underline"
        >Register interest</a>
      ) : (
        <span
          aria-disabled="true"
          title="Registration is currently closed"
          class="mt-2 cursor-not-allowed rounded-full bg-slate-200 px-5 py-2.5 text-center text-[14.5px] font-semibold text-slate-400"
        >Register interest</span>
      )}
    </div>
  </header>

  <script is:inline>
    const navToggle = document.getElementById('nav-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    navToggle.addEventListener('click', () => {
      const open = mobileMenu.classList.toggle('flex');
      mobileMenu.classList.toggle('hidden');
      navToggle.setAttribute('aria-expanded', String(open));
      navToggle.classList.toggle('nav-toggle-open', open);
    });
    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        mobileMenu.classList.remove('flex');
        navToggle.setAttribute('aria-expanded', 'false');
        navToggle.classList.remove('nav-toggle-open');
      });
    });
  </script>

  <style>
    #nav-toggle.nav-toggle-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    #nav-toggle.nav-toggle-open span:nth-child(2) { opacity: 0; }
    #nav-toggle.nav-toggle-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  </style>

  <!-- HERO -->
  <section id="top" class="relative overflow-hidden bg-navy text-white">
    <div class="wn-starfield pointer-events-none absolute inset-0"></div>
    <div
      class="wn-beam absolute -top-[10%] -right-[8%] h-[130%] w-[70%] origin-top-right"
      style="background:linear-gradient(135deg,rgba(53,86,201,0.38),rgba(53,86,201,0))"
    ></div>
    <div
      class="wn-beam absolute -bottom-[30%] -left-[12%] h-[120%] w-[65%]"
      style="background:linear-gradient(135deg,rgba(20,40,120,0.55),rgba(20,40,120,0))"
    ></div>
    <div class="relative mx-auto max-w-shell px-6" style="padding-top:clamp(40px,6vw,72px);padding-bottom:clamp(44px,6vw,76px)">
      <div class="grid items-center gap-x-[clamp(32px,5vw,64px)] gap-y-10 lg:grid-cols-[1fr_1fr]">
        <div>
          <div class="mb-6 inline-flex items-center gap-3 rounded-full border border-white/20 px-4 py-[7px] text-[12.5px] font-semibold uppercase tracking-[0.14em] text-white/[0.78]">
            Mini-conference series
            <span class="h-[5px] w-[5px] rounded-full bg-brand"></span>
            by {site.organiser}
          </div>
          <h1 class="mb-[22px] max-w-[16ch] font-semibold" style="font-size:clamp(30px,4.4vw,54px)">
            {site.tagline}
          </h1>
          <p class="mb-8 max-w-[56ch] text-white/[0.72]" style="font-size:clamp(16px,1.5vw,19px)">
            {site.intro}
          </p>
          <div class="flex flex-wrap items-center gap-3.5">
            <a
              href="#july2026"
              class="rounded-full bg-brand px-7 py-[15px] text-[16px] font-semibold text-white no-underline hover:no-underline"
            >Explore the {edition.shortDate} edition</a>
            {joinListOpen ? (
              <a
                href="#join-list"
                class="rounded-full border border-white/40 px-[27px] py-[14px] text-[16px] font-semibold text-white no-underline hover:no-underline"
              >Register your interest</a>
            ) : (
              <span
                aria-disabled="true"
                title="Registration is currently closed"
                class="cursor-not-allowed rounded-full border border-white/15 px-[27px] py-[14px] text-[16px] font-semibold text-white/35"
              >Register your interest</span>
            )}
          </div>
          <div class="mt-9 flex flex-wrap items-center gap-4">
            <span class="text-[12.5px] font-semibold uppercase tracking-[0.12em] text-white/50">In partnership with</span>
            <MicrosoftMark square={11} textClass="text-[19px]" />
          </div>
        </div>
        <div class="w-full">
          <div class="overflow-hidden rounded-[18px] border border-white/10 bg-white/[0.04] shadow-soft">
            <img
              src={withBase('assets/gallery/A38A2923.jpg')}
              alt="Practitioners at a What's Next? panel discussion"
              class="aspect-[4/3] w-full object-cover"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="bg-paper" style="scroll-margin-top:72px">
    <div class="mx-auto max-w-shell px-6" style="padding-top:clamp(72px,9vw,112px);padding-bottom:clamp(72px,9vw,112px)">
      <div class="grid items-start gap-x-[clamp(32px,5vw,72px)] gap-y-8 md:grid-cols-2">
        <div>
          <div class="mb-[18px] text-[13px] font-semibold uppercase tracking-[0.16em] text-brand">What is What's Next?</div>
          <h2 class="mb-6 font-semibold text-ink" style="font-size:clamp(28px,3.4vw,42px)">A room of practitioners, not a pitch deck.</h2>
          <p class="max-w-[52ch] text-[17px] text-body">
            What's Next? is a mini-conference series organised by {site.organiser} for the people actually shipping AI into production. Each edition brings CTOs, engineering leads and AI practitioners together for short, honest panels — no vendor theatre, just what's working, what broke, and what comes next.
          </p>
        </div>
        <div class="border-l border-[#dfe2ea] pl-[clamp(20px,3vw,40px)]">
          <div class="mb-4 text-[13px] font-semibold uppercase tracking-[0.14em] text-muted">Who it's for</div>
          <div class="flex flex-wrap gap-2.5">
            {audience.map((item) => (
              <span class="rounded-full border border-[#d5d9e2] bg-white px-4 py-2 text-[14px] text-ink">{item}</span>
            ))}
          </div>
          <p class="mt-[22px] text-[14.5px] text-muted">
            Held in Singapore. Speakers to date from {speakerCompanies.slice(0, -1).join(', ')} and {speakerCompanies.at(-1)}.
          </p>
        </div>
      </div>

      <div class="text-[13px] font-semibold uppercase tracking-[0.16em] text-muted" style="margin:clamp(56px,7vw,88px) 0 22px">The themes we dig into</div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {themes.map((theme) => (
          <div class="rounded-[18px] border border-line bg-white p-[30px]">
            <div class="mb-[18px] font-display text-[15px] font-bold text-brand">{theme.no}</div>
            <h3 class="mb-2.5 text-[21px] font-semibold">{theme.title}</h3>
            <p class="text-[15px] text-muted">{theme.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- EVENTS -->
  <section id="events" class="bg-white" style="scroll-margin-top:72px">
    <div class="mx-auto max-w-shell px-6" style="padding-top:clamp(72px,9vw,112px);padding-bottom:clamp(72px,9vw,112px)">
      <div class="mb-4 text-[13px] font-semibold uppercase tracking-[0.16em] text-brand">Events</div>
      <h2 class="mb-10 font-semibold" style="font-size:clamp(28px,3.4vw,42px)">Every edition, most recent first.</h2>

      {site.showUpcoming && (
        <div
          id="join-list"
          class="relative mb-6 grid items-center gap-6 overflow-hidden rounded-[22px] bg-navy p-[clamp(28px,4vw,44px)] text-white sm:grid-cols-2"
          style="scroll-margin-top:84px"
        >
          <div
            class="wn-beam absolute -top-[40%] -right-[6%] h-[180%] w-1/2"
            style="background:linear-gradient(135deg,rgba(53,86,201,0.35),rgba(53,86,201,0))"
          ></div>
          <div class="relative">
            <span class="mb-4 inline-block rounded-full border border-brand/50 bg-brand/[0.16] px-[13px] py-1.5 text-[12px] font-semibold uppercase tracking-[0.12em] text-brand-pink">Next edition</span>
            <h3 class="mb-2.5 font-semibold" style="font-size:clamp(22px,2.6vw,30px)">To be announced</h3>
            <p class="max-w-[46ch] text-[15.5px] text-white/[0.72]">The series continues. Register your interest and be first to hear the theme, date and speaker line-up for the next What's Next?.</p>
          </div>
          <div class="relative w-full sm:max-w-[320px] sm:justify-self-end">
            {site.registrationOpen ? (
              <form id="join-list-form" class="flex flex-col gap-2.5" data-brevo-action={site.brevoFormAction}>
                <label for="join-list-email" class="sr-only">Email address</label>
                <input
                  id="join-list-email"
                  type="email"
                  name="EMAIL"
                  required
                  autocomplete="email"
                  placeholder="you@company.com"
                  class="w-full rounded-full border border-white/20 bg-white/[0.08] px-5 py-3.5 text-[15px] text-white placeholder:text-white/45 outline-none transition focus:border-brand focus:bg-white/[0.12]"
                />
                <button
                  type="submit"
                  class="inline-flex w-full items-center justify-center rounded-full bg-brand px-[26px] py-3.5 text-[15.5px] font-semibold text-white transition hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60"
                >Join the list</button>
                <p id="join-list-status" class="min-h-[18px] text-[13px] text-white/60" role="status" aria-live="polite"></p>
                <input type="text" name="email_address_check" value="" class="hidden" aria-hidden="true" tabindex="-1" autocomplete="off" />
                <input type="hidden" name="locale" value="en" />
                <input type="hidden" name="html_type" value="simple" />
              </form>
            ) : (
              <span
                aria-disabled="true"
                title="Registration is currently closed"
                class="inline-block cursor-not-allowed rounded-full bg-white/10 px-[26px] py-3.5 text-[15.5px] font-semibold text-white/35"
              >Join the list</span>
            )}
          </div>
        </div>
      )}

      <div class="mb-[18px] mt-9 text-[12.5px] font-semibold uppercase tracking-[0.14em] text-muted">Past editions</div>
      <a
        href="#july2026"
        class="group grid grid-cols-1 items-center gap-[clamp(20px,3vw,36px)] rounded-[20px] border border-line bg-white p-[clamp(22px,3vw,32px)] text-inherit no-underline transition-colors hover:border-ink hover:no-underline sm:grid-cols-[auto_1fr_auto]"
      >
        <div class="min-w-[96px] justify-self-start rounded-[14px] bg-navy px-5 py-[18px] text-center text-white sm:justify-self-auto">
          <div class="font-display text-[34px] font-bold leading-none">{edition.number}</div>
          <div class="mt-1 text-[12.5px] uppercase tracking-[0.1em] text-white/70">{edition.shortDate}</div>
        </div>
        <div class="min-w-0">
          <div class="mb-2 text-[12.5px] font-semibold uppercase tracking-[0.12em] text-brand">{edition.label}</div>
          <h3 class="mb-2 font-semibold text-ink" style="font-size:clamp(19px,2.2vw,25px)">{edition.title}</h3>
          <p class="text-[14.5px] text-muted">{edition.venue}, {edition.venueLine.split(' · ')[0]} · In association with {edition.partner}</p>
        </div>
        <div class="whitespace-nowrap text-[15px] font-semibold text-brand">View edition →</div>
      </a>
    </div>
  </section>

  <script is:inline>
    const joinListForm = document.getElementById('join-list-form');
    if (joinListForm) {
      const status = document.getElementById('join-list-status');
      const button = joinListForm.querySelector('button[type="submit"]');

      // Brevo's endpoint doesn't send CORS headers, so the response is
      // opaque and we can never read its status — a request that reaches
      // Brevo and one that gets a 4xx/5xx back look identical from here, no
      // matter the transport. `no-cors` mode is the most honest signal
      // available without a same-origin proxy: it still rejects on a real
      // network-level failure (offline, blocked by an extension, DNS
      // failure), so we only report success when the request actually made
      // it out.
      async function submitToBrevo(action, formData) {
        await fetch(action, {
          method: 'POST',
          mode: 'no-cors',
          body: new URLSearchParams(formData),
        });
      }

      joinListForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        button.disabled = true;
        status.textContent = 'Submitting…';
        status.className = 'min-h-[18px] text-[13px] text-white/60';

        try {
          await submitToBrevo(joinListForm.dataset.brevoAction, new FormData(joinListForm));
          status.textContent = "You're on the list — thanks!";
          status.className = 'min-h-[18px] text-[13px] text-brand-pink';
          joinListForm.reset();
        } catch (error) {
          status.textContent = 'Something went wrong — please try again.';
          status.className = 'min-h-[18px] text-[13px] text-red-300';
        } finally {
          button.disabled = false;
        }
      });
    }
  </script>

  <!-- JULY 2026 — EDITION HEADER -->
  <section id="july2026" class="relative overflow-hidden bg-navy text-white" style="scroll-margin-top:68px">
    <div
      class="wn-beam absolute -top-[10%] -left-[8%] h-[130%] w-[60%]"
      style="background:linear-gradient(135deg,rgba(53,86,201,0.3),rgba(53,86,201,0))"
    ></div>
    <div class="relative mx-auto max-w-shell px-6" style="padding-top:clamp(64px,8vw,104px);padding-bottom:clamp(64px,8vw,104px)">
      <div class="grid items-center gap-x-[clamp(32px,5vw,64px)] gap-y-10 lg:grid-cols-[1.45fr_0.55fr]">
        <div>
          <div class="mb-[18px] text-[13px] font-semibold uppercase tracking-[0.16em] text-brand-pink">{edition.date.split(' ').slice(1).join(' ')} Edition · Inaugural</div>
          <h2 class="mb-5 max-w-[18ch] font-semibold" style="font-size:clamp(30px,4.4vw,56px)">{edition.title}</h2>
          <div class="mb-12 flex flex-wrap gap-3">
            {edition.topics.map((topic) => (
              <span class="rounded-full border border-white/20 px-[15px] py-[7px] text-[13.5px] text-white/85">{topic}</span>
            ))}
          </div>
          <div class="grid gap-7 border-t border-white/[0.14] pt-9 sm:grid-cols-2 lg:grid-cols-4">
            <div>
              <div class="mb-2 text-[12px] font-semibold uppercase tracking-[0.14em] text-brand-pink">Date</div>
              <div class="text-[18px] font-medium">{edition.date}</div>
            </div>
            <div>
              <div class="mb-2 text-[12px] font-semibold uppercase tracking-[0.14em] text-brand-pink">Time</div>
              <div class="text-[18px] font-medium">{edition.time}</div>
            </div>
            <div>
              <div class="mb-2 text-[12px] font-semibold uppercase tracking-[0.14em] text-brand-pink">Venue</div>
              <div class="text-[18px] font-medium">{edition.venue}</div>
              <div class="mt-0.5 text-[14.5px] text-white/[0.65]">
                {edition.venueLine} · <a href={edition.venueMapUrl} target="_blank" rel="noopener" class="text-brand-pink">Map</a>
              </div>
            </div>
            <div>
              <div class="mb-2 text-[12px] font-semibold uppercase tracking-[0.14em] text-brand-pink">Partner</div>
              <MicrosoftMark square={10} textClass="text-[18px]" />
            </div>
          </div>
        </div>
        <div class="w-full">
          <div class="overflow-hidden rounded-[18px] border border-white/10 bg-white/[0.04] shadow-soft">
            <img
              src={withBase('assets/event-poster.png')}
              alt={`${edition.title} — ${edition.date} event poster`}
              class="aspect-[3/4] w-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- AGENDA -->
  <section id="agenda" class="bg-paper" style="scroll-margin-top:72px">
    <div class="mx-auto max-w-shell px-6" style="padding-top:clamp(64px,8vw,100px);padding-bottom:clamp(64px,8vw,100px)">
      <div class="mb-4 text-[13px] font-semibold uppercase tracking-[0.16em] text-brand">Programme</div>
      <h2 class="mb-3 font-semibold" style="font-size:clamp(26px,3.2vw,38px)">The evening, in order.</h2>
      <p class="mb-11 text-[15px] text-muted">Doors from {edition.agenda[0].time}. Three practitioner panels, bookended by networking.</p>
      <div class="max-w-[820px]">
        {edition.agenda.map((item, i) => (
          <div
            class:list={[
              'grid gap-x-[clamp(16px,3vw,36px)] gap-y-2 border-t border-[#e0e3ea] py-[22px] [grid-template-columns:120px_1fr]',
              i === edition.agenda.length - 1 && 'border-b',
            ]}
          >
            <div class="font-display text-[19px] font-semibold text-brand">{item.time}</div>
            <div>
              <h3 class="mb-1 text-[18px] font-semibold">{item.title}</h3>
              <p class="text-[14.5px] text-muted">{item.detail}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SPEAKERS -->
  <section id="speakers" class="bg-white" style="scroll-margin-top:72px">
    <div class="mx-auto max-w-shell px-6" style="padding-top:clamp(64px,8vw,100px);padding-bottom:clamp(64px,8vw,100px)">
      <div class="mb-4 text-[13px] font-semibold uppercase tracking-[0.16em] text-brand">Speakers · {edition.date.split(' ').slice(1).join(' ')}</div>
      <h2 class="mb-3 font-semibold" style="font-size:clamp(26px,3.2vw,38px)">Practitioners from across the industry.</h2>
      <p class="mb-11 max-w-[60ch] text-[15px] text-muted">Speakers joined from the organisations below. Names and headshots are added as they're confirmed.</p>
      <div class="grid gap-[22px] sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {edition.speakers.map((speaker) => (
          <div class="rounded-[18px] border border-line bg-white p-[22px]">
            <div class="mb-[18px] flex h-[84px] w-[84px] items-center justify-center overflow-hidden rounded-full bg-paper text-[11px] text-muted">
              {speaker.image
                ? <img src={withBase(speaker.image)} alt={speaker.name} class="h-full w-full object-cover" />
                : <span>Headshot</span>}
            </div>
            <div class="text-[17px] font-semibold text-ink">{speaker.name}</div>
            <div class="mb-3 text-[14px] text-muted">{speaker.role} · {speaker.company}</div>
            <span class="inline-block rounded-full bg-brand-soft px-[11px] py-[5px] text-[11.5px] font-semibold uppercase tracking-[0.08em] text-brand">{speaker.topic}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section id="gallery" class="bg-paper" style="scroll-margin-top:72px">
    <div class="mx-auto max-w-shell px-6" style="padding-top:clamp(64px,8vw,100px);padding-bottom:clamp(64px,8vw,100px)">
      <div class="mb-4 text-[13px] font-semibold uppercase tracking-[0.16em] text-brand">Gallery · {edition.date.split(' ').slice(1).join(' ')}</div>
      <h2 class="mb-3 font-semibold" style="font-size:clamp(26px,3.2vw,38px)">From the night.</h2>
      <p class="mb-9 text-[15px] text-muted">Event photos are added after each edition.</p>
      <div class="grid auto-rows-[200px] grid-cols-2 gap-3.5 sm:grid-cols-3 lg:grid-cols-4">
        {galleryTiles.map((tile, i) => (
          <div class:list={['overflow-hidden rounded-2xl', tile.span]}>
            {edition.gallery[i]
              ? (
                <button
                  type="button"
                  data-gallery-open
                  data-index={i}
                  aria-label={`Open photo ${i + 1} of ${edition.gallery.length}`}
                  class="group block h-full w-full cursor-zoom-in overflow-hidden border-0 p-0"
                >
                  <img
                    src={galleryImages[i]}
                    alt={`Event photo ${i + 1}`}
                    class="h-full w-full object-cover transition duration-200 group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                </button>
              )
              : <div class="flex h-full w-full items-center justify-center border border-line bg-white text-[12px] text-muted">{tile.label}</div>}
          </div>
        ))}
      </div>

      {edition.gallery.length > 0 && (
        <div class="mt-8 flex justify-center">
          <button
            type="button"
            data-gallery-open
            data-index="0"
            class="rounded-full border border-line bg-white px-6 py-3 text-[14.5px] font-semibold text-ink hover:border-ink"
          >
            {edition.gallery.length > galleryTiles.length
              ? `See all ${edition.gallery.length} photos`
              : 'View gallery'}
          </button>
        </div>
      )}
    </div>

    <!-- Full-screen photo lightbox / carousel. The dialog fills the viewport
         so the controls below are positioned relative to the screen edges,
         not the photo — otherwise a large photo leaves no room for them and
         they get clipped by the viewport instead of floating around it. -->
    <dialog
      id="gallery-lightbox"
      class="h-full max-h-none w-full max-w-none border-0 bg-transparent p-0 [&::backdrop]:bg-navy/90"
    >
      <div id="gallery-lightbox-frame" class="relative flex h-full w-full items-center justify-center p-4 sm:p-8">
        <button
          type="button"
          data-gallery-close
          aria-label="Close gallery"
          class="absolute right-3 top-3 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white text-[18px] font-semibold text-ink shadow-soft hover:bg-paper sm:right-6 sm:top-6"
        >✕</button>
        <button
          type="button"
          data-gallery-prev
          aria-label="Previous photo"
          class="absolute left-2 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white/90 text-[22px] font-semibold text-ink shadow-soft hover:bg-white sm:left-6"
        >‹</button>
        <img id="gallery-lightbox-img" src="" alt="" class="max-h-[78vh] max-w-[82vw] rounded-xl object-contain" />
        <button
          type="button"
          data-gallery-next
          aria-label="Next photo"
          class="absolute right-2 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white/90 text-[22px] font-semibold text-ink shadow-soft hover:bg-white sm:right-6"
        >›</button>
        <p id="gallery-lightbox-counter" class="absolute bottom-3 left-1/2 -translate-x-1/2 text-[13px] font-medium text-white/80 sm:bottom-6"></p>
      </div>
    </dialog>
  </section>

  <script is:inline define:vars={{ galleryImages }}>
    const dialog = document.getElementById('gallery-lightbox');
    const imgEl = document.getElementById('gallery-lightbox-img');
    const counterEl = document.getElementById('gallery-lightbox-counter');
    let currentIndex = 0;

    function render() {
      if (!galleryImages.length) return;
      imgEl.src = galleryImages[currentIndex];
      imgEl.alt = `Event photo ${currentIndex + 1}`;
      counterEl.textContent = `${currentIndex + 1} / ${galleryImages.length}`;
    }

    function openAt(index) {
      if (!galleryImages.length) return;
      currentIndex = ((index % galleryImages.length) + galleryImages.length) % galleryImages.length;
      render();
      if (!dialog.open) dialog.showModal();
    }

    function next() { openAt(currentIndex + 1); }
    function prev() { openAt(currentIndex - 1); }

    document.querySelectorAll('[data-gallery-open]').forEach((btn) => {
      btn.addEventListener('click', () => openAt(Number(btn.dataset.index || 0)));
    });
    dialog.querySelector('[data-gallery-close]').addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-gallery-next]').addEventListener('click', next);
    dialog.querySelector('[data-gallery-prev]').addEventListener('click', prev);

    // Click on the backdrop area (outside the image/controls) closes the
    // dialog. The frame div fills the whole dialog, so a backdrop click
    // lands on either the dialog itself or directly on the frame's own
    // background — never on the image or a button, which are separate
    // elements.
    const frame = document.getElementById('gallery-lightbox-frame');
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog || event.target === frame) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') next();
      if (event.key === 'ArrowLeft') prev();
    });
  </script>

  <!-- FOOTER -->
  <footer class="text-white" style="background:#050507">
    <div class="mx-auto max-w-shell px-6" style="padding:36px 24px 54px">
      <div class="grid items-center gap-[30px] sm:grid-cols-[320px_1fr]">
        <div class="flex flex-wrap gap-3">
          <a href="https://www.zenika.com/en-SG" target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/[0.18] px-4 py-3 text-[14px] font-bold text-white no-underline hover:no-underline">Zenika Website</a>
          <a href="https://jobs.zenika.sg/" target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/[0.18] px-4 py-3 text-[14px] font-bold text-white no-underline hover:no-underline">Zenika Jobs</a>
          <a href="https://training.zenika.sg/" target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/[0.18] px-4 py-3 text-[14px] font-bold text-white no-underline hover:no-underline">Zenika SG Training</a>
        </div>
        <p class="text-[15px] leading-[1.72] text-white/[0.76]">
          {site.name} is a mini-conference series on AI-Driven Development, organised by {site.organiser} for the people actually shipping AI into production.
        </p>
      </div>
      <div class="mt-7 h-px bg-white/[0.12]"></div>
      <div class="mt-[26px] grid place-items-center gap-[10px] text-center">
        <img src={withBase('assets/zenika-logo.png')} alt="Zenika" class="h-11 w-auto" />
        <p class="text-white/[0.74]">Practitioner-led conversation on AI-Driven Development, by {site.organiser}.</p>
        <div class="flex items-center gap-2">
          <span class="text-[12.5px] text-white/50">In partnership with</span>
          <MicrosoftMark square={9} textClass="text-[14px]" colorClass="text-white/85" />
        </div>
        <small class="text-white/[0.74]">Copyright © 2026 {site.organiser}</small>
      </div>
    </div>
  </footer>
</BaseLayout>
